# ─────────────────────────────────────
# Database (PostgreSQL, async)
# ─────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5432/plantuml_web

# ─────────────────────────────────────
# SC-Web (graphical editor component)
# ─────────────────────────────────────
# По умолчанию: <project_root>/external/sc-web
# Раскомментируй, если путь отличается
# SC_WEB_ROOT=/path/to/sc-web

# ─────────────────────────────────────
# SC-Machine (knowledge engine)
# ─────────────────────────────────────
SC_SERVER_HOST=localhost
SC_SERVER_PORT=8090

# ─────────────────────────────────────
# Server
# ─────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─────────────────────────────────────
# CORS (через запятую или * для всех)
# ─────────────────────────────────────
ALLOWED_ORIGINS=*

# ─────────────────────────────────────
# Timeouts (опционально, значения по умолчанию разумны)
# ─────────────────────────────────────
# EVENT_WAIT_TIMEOUT=10
# ACTION_RESULT_WAIT_TIMEOUT=2
# IDTF_SEARCH_LIMIT=100
# RECONNECT_RETRIES=5
# RECONNECT_RETRY_DELAY=2.0
